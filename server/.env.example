# ---- Kanban API configuration ----
# Copy to .env and fill in values before starting the server.

# Port the API listens on
PORT=4000

# Postgres connection. Leave UNSET to run with the in-memory store
# (zero-infra demo mode). Set it to enable the Postgres path.
# DATABASE_URL=postgres://kanban:kanban@db:5432/kanban

# Secret used to sign JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# CORS — the origin the web frontend is served from.
# Only requests from this origin are accepted (credentials included).
WEB_ORIGIN=http://localhost:8080

# Project-wide provisioning token. Authorises creating new agents and
# minting/rotating their tokens (POST /api/agents, POST /api/agents/:id/token)
# via the X-Provision-Token header. Leave UNSET to disable provisioning.
#   openssl rand -hex 32
PROVISION_TOKEN=replace-with-a-long-random-string

# ---- Multi-factor auth (manager login) ----
# When true, the manager's password login is refused once a passkey is enrolled,
# forcing the passkey (device + user-verification = phishing-resistant MFA).
# Bootstrap-safe: has no effect until a passkey exists, so it cannot lock you out
# before enrolment. Recovery if the passkey device is lost: set back to false.
MFA_REQUIRED=false

# WebAuthn relying-party config (passkeys). Default to WEB_ORIGIN's host, so you
# usually don't need these. Set them only if the API is reached from a different
# origin than the site (e.g. a custom domain in front of prod). RP_ID is the
# registrable domain, no scheme; passkeys are bound to it.
# WEBAUTHN_ORIGIN=https://board.example.com
# WEBAUTHN_RP_ID=board.example.com
# WEBAUTHN_RP_NAME=Kanban
